{% doc %}
  @prompt
    create a minimalistic product grid that has the text and name of the product under a product from a collection. The product's backgrounds should be transparent, and this grid should be over top of some editable text in the background
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-grid-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-product-grid-background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
    box-sizing: border-box;
  }

  /* "Ghost type" effect: bold + uppercase + wide tracking so a color barely
     darker than the background still reads as a deliberate watermark */
  .ai-product-grid-background-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.background_text_size }}px;
    color: {{ block.settings.background_text_color }};
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1.1;
    text-align: center;
    max-width: 100%;
    word-wrap: break-word;
  }

  .ai-product-grid-container-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    padding: {{ block.settings.grid_padding }}px;
  }

  .ai-product-grid-items-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-product-grid-item-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    flex-direction: column;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-product-grid-doodle-{{ ai_gen_id }} {
    position: absolute;
    z-index: 3;
    height: auto;
    opacity: {{ block.settings.doodle_opacity | divided_by: 100.0 }};
    pointer-events: none;
    user-select: none;
  }
  /* Four corners, kept fully inside the tile's own box (no negative
     offsets), so a doodle can never bleed into a neighboring product no
     matter how tight the grid gap is. Each product randomly uses 3 or 4
     of them. Each corner has its own base tilt direction (see the loop
     below) so angles are always visibly different corner to corner, on
     top of a per-product random jitter. */
  .ai-product-grid-doodle-corner-0-{{ ai_gen_id }} {
    top: 4%;
    left: 4%;
  }
  .ai-product-grid-doodle-corner-1-{{ ai_gen_id }} {
    top: 4%;
    right: 4%;
  }
  .ai-product-grid-doodle-corner-2-{{ ai_gen_id }} {
    bottom: 18%;
    left: 4%;
  }
  .ai-product-grid-doodle-corner-3-{{ ai_gen_id }} {
    bottom: 18%;
    right: 4%;
  }

  .ai-product-grid-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    margin-bottom: {{ block.settings.text_spacing }}px;
  }

  .ai-product-grid-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: transparent;
  }

  .ai-product-grid-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
  }

  .ai-product-grid-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-product-grid-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
    font-weight: 400;
  }

  .ai-product-grid-title-{{ ai_gen_id }} a {
    color: inherit;
    text-decoration: none;
  }

  .ai-product-grid-title-{{ ai_gen_id }} a:hover {
    opacity: 0.7;
  }

  .ai-product-grid-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_price_color }};
  }

  .ai-product-grid-empty-{{ ai_gen_id }} {
    grid-column: 1 / -1;
    text-align: center;
    padding: 60px 20px;
    color: {{ block.settings.product_title_color }};
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-product-grid-items-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-product-grid-background-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.background_text_size }}px * 0.6);
    }

    .ai-product-grid-container-{{ ai_gen_id }} {
      padding: {{ block.settings.grid_padding | times: 0.5 }}px;
    }
  }
{% endstyle %}

<product-grid-{{ ai_gen_id }} class="ai-product-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-grid-background-{{ ai_gen_id }}">
    <div class="ai-product-grid-background-text-{{ ai_gen_id }}">
      {{ block.settings.background_text }}
    </div>
  </div>

  <div class="ai-product-grid-container-{{ ai_gen_id }}">
    <div class="ai-product-grid-items-{{ ai_gen_id }}">
      {% if block.settings.collection != blank %}
        {% assign products_to_show = block.settings.products_limit %}
        {% for product in block.settings.collection.products limit: products_to_show %}
          <div class="ai-product-grid-item-{{ ai_gen_id }}">
            {% if block.settings.enable_doodles %}
              {% assign total_count = 3 %}
              {% assign count_parity = product.id | modulo: 2 %}
              {% if count_parity == 1 %}
                {% assign total_count = 4 %}
              {% endif %}

              {% assign skip_corner = -1 %}
              {% if total_count == 3 %}
                {% assign skip_corner = product.id | modulo: 4 %}
              {% endif %}

              {% for corner in (0..3) %}
                {% assign corner_index = forloop.index0 %}
                {% if corner_index != skip_corner %}
                  {% assign hash_seed = product.id | plus: corner_index | times: 9 %}

                  {% assign doodle_pick = hash_seed | modulo: 6 %}
                  {% case doodle_pick %}
                    {% when 0 %}
                      {% assign doodle_img = block.settings.doodle_1 %}
                    {% when 1 %}
                      {% assign doodle_img = block.settings.doodle_2 %}
                    {% when 2 %}
                      {% assign doodle_img = block.settings.doodle_3 %}
                    {% when 3 %}
                      {% assign doodle_img = block.settings.doodle_4 %}
                    {% when 4 %}
                      {% assign doodle_img = block.settings.doodle_5 %}
                    {% when 5 %}
                      {% assign doodle_img = block.settings.doodle_6 %}
                  {% endcase %}

                  {% if doodle_img != blank %}
                    {% assign base_rotation = -15 %}
                    {% case corner_index %}
                      {% when 1 %}
                        {% assign base_rotation = 12 %}
                      {% when 2 %}
                        {% assign base_rotation = 18 %}
                      {% when 3 %}
                        {% assign base_rotation = -20 %}
                    {% endcase %}
                    {% assign rotation_jitter = hash_seed | plus: 13 | modulo: 17 | minus: 8 %}
                    {% assign rotation = base_rotation | plus: rotation_jitter %}

                    {% assign size_seed = hash_seed | plus: 17 | modulo: 6 %}
                    {% assign size_percent = size_seed | times: 7 | plus: 85 %}
                    {% assign doodle_px = block.settings.doodle_size | times: size_percent | divided_by: 100 %}
                    <img
                      src="{{ doodle_img | image_url: width: 200 }}"
                      alt=""
                      aria-hidden="true"
                      loading="lazy"
                      class="ai-product-grid-doodle-{{ ai_gen_id }} ai-product-grid-doodle-corner-{{ corner_index }}-{{ ai_gen_id }}"
                      style="width: {{ doodle_px }}px; transform: rotate({{ rotation }}deg);"
                    >
                  {% endif %}
                {% endif %}
              {% endfor %}
            {% endif %}
            <div class="ai-product-grid-image-wrapper-{{ ai_gen_id }}">
              <a href="{{ product.url }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-product-grid-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                {% else %}
                  <div class="ai-product-grid-image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </a>
            </div>

            <h3 class="ai-product-grid-title-{{ ai_gen_id }}">
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h3>

            <div class="ai-product-grid-price-{{ ai_gen_id }}">
              {{ product.price | money }}
            </div>
          </div>
        {% endfor %}
      {% else %}
        <div class="ai-product-grid-empty-{{ ai_gen_id }}">
          Select a collection to display products
        </div>
      {% endif %}
    </div>
  </div>
</product-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('product-grid-{{ ai_gen_id }}', ProductGrid{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Product grid",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Products to show",
      "min": 3,
      "max": 24,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "Background text"
    },
    {
      "type": "richtext",
      "id": "background_text",
      "label": "Background text",
      "default": "<p>SHOP NOW</p>"
    },
    {
      "type": "range",
      "id": "background_text_size",
      "label": "Text size",
      "min": 20,
      "max": 200,
      "step": 10,
      "default": 100,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "background_text_color",
      "label": "Text color",
      "info": "For a subtle watermark effect, keep this barely darker than the page background.",
      "default": "#f5f5f5"
    },
    {
      "type": "header",
      "content": "Grid layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Gap between products",
      "min": 0,
      "max": 60,
      "step": 5,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "grid_padding",
      "label": "Grid padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Product info"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "text_spacing",
      "label": "Space below image",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "product_title_size",
      "label": "Title size",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "product_title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "title_spacing",
      "label": "Space below title",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "product_price_size",
      "label": "Price size",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 13,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "product_price_color",
      "label": "Price color",
      "default": "#969696"
    },
    {
      "type": "header",
      "content": "Doodle overlays"
    },
    {
      "type": "checkbox",
      "id": "enable_doodles",
      "label": "Enable doodle overlays",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "doodle_1",
      "label": "Doodle 1",
      "info": "Upload up to 6 doodles. Each product randomly shows 3 or 4 of them in its corners, each with a distinct tilt and its own random size so they feel hand-placed. Doodles stay inside each product's own tile, so they never overlap each other or bleed into neighboring products, and the combination varies from product to product."
    },
    {
      "type": "image_picker",
      "id": "doodle_2",
      "label": "Doodle 2"
    },
    {
      "type": "image_picker",
      "id": "doodle_3",
      "label": "Doodle 3"
    },
    {
      "type": "image_picker",
      "id": "doodle_4",
      "label": "Doodle 4"
    },
    {
      "type": "image_picker",
      "id": "doodle_5",
      "label": "Doodle 5"
    },
    {
      "type": "image_picker",
      "id": "doodle_6",
      "label": "Doodle 6"
    },
    {
      "type": "range",
      "id": "doodle_size",
      "label": "Doodle base size",
      "info": "Each doodle instance is randomly scaled 85-120% of this size.",
      "min": 20,
      "max": 150,
      "step": 5,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "doodle_opacity",
      "label": "Doodle opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 100,
      "unit": "%"
    }
  ],
  "presets": [
    {
      "name": "Product grid"
    }
  ]
}
{% endschema %}
