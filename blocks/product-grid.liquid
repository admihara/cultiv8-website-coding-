{% doc %}
  @prompt
    create a minimalistic product grid that has the text and name of the product under a product from a collection. The product's backgrounds should be transparent, and this grid should be over top of some editable text in the background
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-grid-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-product-grid-background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
    box-sizing: border-box;
  }

  /* "Ghost type" effect: bold + uppercase + wide tracking so a color barely
     darker than the background still reads as a deliberate watermark */
  .ai-product-grid-background-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.background_text_size }}px;
    color: {{ block.settings.background_text_color }};
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1.1;
    text-align: center;
    max-width: 100%;
    word-wrap: break-word;
  }

  .ai-product-grid-container-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    padding: {{ block.settings.grid_padding }}px;
  }

  .ai-product-grid-items-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-product-grid-item-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    flex-direction: column;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-product-grid-doodle-{{ ai_gen_id }} {
    position: absolute;
    z-index: 3;
    width: {{ block.settings.doodle_size }}px;
    height: auto;
    opacity: {{ block.settings.doodle_opacity | divided_by: 100.0 }};
    pointer-events: none;
    user-select: none;
  }
  .ai-product-grid-item-{{ ai_gen_id }}:nth-child(6n+1) .ai-product-grid-doodle-{{ ai_gen_id }} {
    top: -10%;
    left: -10%;
    transform: rotate(-12deg);
  }
  .ai-product-grid-item-{{ ai_gen_id }}:nth-child(6n+2) .ai-product-grid-doodle-{{ ai_gen_id }} {
    top: -8%;
    right: -12%;
    transform: rotate(9deg);
  }
  .ai-product-grid-item-{{ ai_gen_id }}:nth-child(6n+3) .ai-product-grid-doodle-{{ ai_gen_id }} {
    bottom: 18%;
    left: -10%;
    transform: rotate(15deg);
  }
  .ai-product-grid-item-{{ ai_gen_id }}:nth-child(6n+4) .ai-product-grid-doodle-{{ ai_gen_id }} {
    bottom: 20%;
    right: -12%;
    transform: rotate(-18deg);
  }
  .ai-product-grid-item-{{ ai_gen_id }}:nth-child(6n+5) .ai-product-grid-doodle-{{ ai_gen_id }} {
    top: -12%;
    left: 42%;
    transform: rotate(6deg);
  }
  .ai-product-grid-item-{{ ai_gen_id }}:nth-child(6n) .ai-product-grid-doodle-{{ ai_gen_id }} {
    bottom: 22%;
    right: 38%;
    transform: rotate(-6deg);
  }

  .ai-product-grid-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    margin-bottom: {{ block.settings.text_spacing }}px;
  }

  .ai-product-grid-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: transparent;
  }

  .ai-product-grid-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
  }

  .ai-product-grid-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-product-grid-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
    font-weight: 400;
  }

  .ai-product-grid-title-{{ ai_gen_id }} a {
    color: inherit;
    text-decoration: none;
  }

  .ai-product-grid-title-{{ ai_gen_id }} a:hover {
    opacity: 0.7;
  }

  .ai-product-grid-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_price_color }};
  }

  .ai-product-grid-empty-{{ ai_gen_id }} {
    grid-column: 1 / -1;
    text-align: center;
    padding: 60px 20px;
    color: {{ block.settings.product_title_color }};
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-product-grid-items-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-product-grid-background-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.background_text_size }}px * 0.6);
    }

    .ai-product-grid-container-{{ ai_gen_id }} {
      padding: {{ block.settings.grid_padding | times: 0.5 }}px;
    }
  }
{% endstyle %}

<product-grid-{{ ai_gen_id }} class="ai-product-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-grid-background-{{ ai_gen_id }}">
    <div class="ai-product-grid-background-text-{{ ai_gen_id }}">
      {{ block.settings.background_text }}
    </div>
  </div>

  <div class="ai-product-grid-container-{{ ai_gen_id }}">
    <div class="ai-product-grid-items-{{ ai_gen_id }}">
      {% if block.settings.collection != blank %}
        {% assign products_to_show = block.settings.products_limit %}
        {% for product in block.settings.collection.products limit: products_to_show %}
          {% assign doodle_img = blank %}
          {% if block.settings.enable_doodles %}
            {% assign doodle_slot = forloop.index0 | modulo: 3 %}
            {% case doodle_slot %}
              {% when 0 %}
                {% assign doodle_img = block.settings.doodle_1 %}
              {% when 1 %}
                {% assign doodle_img = block.settings.doodle_2 | default: block.settings.doodle_1 %}
              {% when 2 %}
                {% assign doodle_img = block.settings.doodle_3 | default: block.settings.doodle_1 %}
            {% endcase %}
          {% endif %}
          <div class="ai-product-grid-item-{{ ai_gen_id }}">
            {% if doodle_img != blank %}
              <img
                src="{{ doodle_img | image_url: width: 200 }}"
                alt=""
                aria-hidden="true"
                loading="lazy"
                class="ai-product-grid-doodle-{{ ai_gen_id }}"
              >
            {% endif %}
            <div class="ai-product-grid-image-wrapper-{{ ai_gen_id }}">
              <a href="{{ product.url }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-product-grid-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                {% else %}
                  <div class="ai-product-grid-image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </a>
            </div>

            <h3 class="ai-product-grid-title-{{ ai_gen_id }}">
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h3>

            <div class="ai-product-grid-price-{{ ai_gen_id }}">
              {{ product.price | money }}
            </div>
          </div>
        {% endfor %}
      {% else %}
        <div class="ai-product-grid-empty-{{ ai_gen_id }}">
          Select a collection to display products
        </div>
      {% endif %}
    </div>
  </div>
</product-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('product-grid-{{ ai_gen_id }}', ProductGrid{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Product grid",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Products to show",
      "min": 3,
      "max": 24,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "Background text"
    },
    {
      "type": "richtext",
      "id": "background_text",
      "label": "Background text",
      "default": "<p>SHOP NOW</p>"
    },
    {
      "type": "range",
      "id": "background_text_size",
      "label": "Text size",
      "min": 20,
      "max": 200,
      "step": 10,
      "default": 100,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "background_text_color",
      "label": "Text color",
      "info": "For a subtle watermark effect, keep this barely darker than the page background.",
      "default": "#f5f5f5"
    },
    {
      "type": "header",
      "content": "Grid layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Gap between products",
      "min": 0,
      "max": 60,
      "step": 5,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "grid_padding",
      "label": "Grid padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Product info"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "text_spacing",
      "label": "Space below image",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "product_title_size",
      "label": "Title size",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "product_title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "title_spacing",
      "label": "Space below title",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "product_price_size",
      "label": "Price size",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 13,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "product_price_color",
      "label": "Price color",
      "default": "#969696"
    },
    {
      "type": "header",
      "content": "Doodle overlays"
    },
    {
      "type": "checkbox",
      "id": "enable_doodles",
      "label": "Enable doodle overlays",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "doodle_1",
      "label": "Doodle 1"
    },
    {
      "type": "image_picker",
      "id": "doodle_2",
      "label": "Doodle 2",
      "info": "Optional. Alternates with Doodle 1 across products for variety. Leave blank to reuse Doodle 1."
    },
    {
      "type": "image_picker",
      "id": "doodle_3",
      "label": "Doodle 3",
      "info": "Optional. Leave blank to reuse Doodle 1."
    },
    {
      "type": "range",
      "id": "doodle_size",
      "label": "Doodle size",
      "min": 20,
      "max": 150,
      "step": 5,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "doodle_opacity",
      "label": "Doodle opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 100,
      "unit": "%"
    }
  ],
  "presets": [
    {
      "name": "Product grid"
    }
  ]
}
{% endschema %}
