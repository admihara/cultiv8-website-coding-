<style>
  /* ---------- Hero header (homepage, over the image banner) ---------- */
  .hero-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 20;
    background: transparent;
    opacity: 1;
    transition: opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .site-header.past-banner .hero-header {
    opacity: 0;
    pointer-events: none;
  }
  .header-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    row-gap: 10px;
  }
  .header-menu,
  .right-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    flex: 1 1 0;
    gap: {{ section.settings.link-spacing }}px;
  }
  .header-menu {
    justify-content: flex-end;
  }
  .right-nav {
    justify-content: flex-start;
  }
  .hero-header .logo-wrapper {
    flex: 0 0 auto;
    padding: 20px {{ section.settings.link-spacing }}px;
    margin: 0 auto;
  }
  .hero-header .logo-wrapper img {
    width: {{ section.settings.logo-size }}px;
    max-width: 100%;
  }
  .header-menu .menu-item > a,
  .right-nav a,
  .hero-header .header-logo-text {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 400;
    font-size: {{ section.settings.nav-text-size }}px;
    white-space: nowrap;
    text-decoration: none;
    color: {{ settings.header-overlay-menu-color }};
  }
  .hero-header .header-logo-text {
    text-transform: none;
    letter-spacing: normal;
  }
  .submenu {
    display: none;
    position: absolute;
    box-shadow: 0 2px 3px rgba(0,0,0,0.1);
    background: {{ settings.submenu-bg }};
    z-index: 100;
    left: 50%;
    transform: translateX(-50%);
    margin-top: 10px;
    flex-direction: column;
    padding: 0;
    min-width: 150px;
  }
  .subsub-menu-item {
    padding-top: 0 !important;
    font-size: 0.8em;
  }
  .submenu a {
    padding: 10px;
    display: block;
    text-decoration: none;
    text-align: center;
    white-space: nowrap;
  }
  .has-children {
    position: relative;
  }
  .has-children > a:after {
    content: ' +';
  }
  .has-children.active > a:after {
    content: ' -';
  }
  @media screen and (min-width: 750px){
    .submenu a {
      color: {{ settings.submenu-color }};
    }
  }
  @media screen and (max-width: 749px) {
    .hero-header {
      display: none;
    }
  }

  /* ---------- Compact header (hamburger / logo / cart icon) ---------- */
  .compact-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 30;
    background: transparent;
    color: {{ settings.header-overlay-menu-color }};
    opacity: 1;
    transition: opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1), transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.4s ease, color 0.4s ease;
  }
  .site-header.past-banner .compact-header {
    background: {{ section.settings.compact-bg }};
    color: {{ section.settings.compact-color }};
  }
  .site-header.past-banner.header-hidden .compact-header {
    transform: translateY(-100%);
  }
  @media screen and (min-width: 750px) {
    .compact-header {
      opacity: 0;
      pointer-events: none;
    }
    .site-header.past-banner .compact-header {
      opacity: 1;
      pointer-events: auto;
    }
  }
  .compact-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: {{ section.settings.compact-padding-y }}px {{ section.settings.compact-padding-x }}px;
  }
  .compact-logo-wrapper {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: block;
    line-height: 0;
  }
  .compact-logo-wrapper img {
    width: {{ section.settings.logo-size-compact }}px;
    max-width: 100%;
    display: block;
  }
  .compact-logo-wrapper img,
  .compact-logo-wrapper .header-logo-text {
    transition: opacity 0.4s ease;
  }
  .compact-logo-wrapper .logo-original {
    opacity: 1;
  }
  .compact-logo-wrapper .logo-alt {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
  }
  .site-header.past-banner .compact-logo-wrapper .logo-original {
    opacity: 0;
  }
  .site-header.past-banner .compact-logo-wrapper .logo-alt {
    opacity: 1;
  }
  .burger-menu,
  .cart-icon-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    color: currentColor;
  }
  .burger-menu svg,
  .cart-icon-link svg {
    width: {{ section.settings.compact-icon-size }}px;
    height: {{ section.settings.compact-icon-size }}px;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
    overflow: visible;
  }
  .burger-menu .cross {
    display: none;
  }
  .burger-menu.active .burger {
    display: none;
  }
  .burger-menu.active .cross {
    display: block;
  }
  .cart-count-bubble {
    position: absolute;
    top: -6px;
    right: -8px;
    min-width: 16px;
    height: 16px;
    padding: 0 3px;
    border-radius: 50%;
    background: {{ section.settings.compact-color }};
    font-size: 10px;
    line-height: 16px;
    text-align: center;
  }
  .cart-count-bubble span {
    color: {{ section.settings.compact-bg }};
  }
  @media screen and (max-width: 749px) {
    .compact-wrapper {
      padding: {{ section.settings.compact-padding-y-mobile }}px {{ section.settings.compact-padding-x-mobile }}px;
    }
    .compact-logo-wrapper img {
      width: {{ section.settings.logo-size-compact-mobile }}px;
    }
    .burger-menu svg,
    .cart-icon-link svg {
      width: {{ section.settings.compact-icon-size-mobile }}px;
      height: {{ section.settings.compact-icon-size-mobile }}px;
    }
  }

  /* ---------- Fullscreen nav flyout (opened by hamburger) ---------- */
  .mobile-nav-flyout {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: {{ section.settings.compact-bg }};
    color: {{ section.settings.compact-color }};
    z-index: 40;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow-y: auto;
  }
  .mobile-nav-flyout.active {
    display: flex;
  }
  .mobile-nav-flyout .menu-item {
    text-transform: uppercase;
    font-size: 25px;
    text-align: center;
    margin-bottom: 1.7rem;
  }
  .mobile-nav-flyout .menu-item > a {
    text-decoration: none;
    color: currentColor;
  }
  .mobile-nav-flyout .submenu {
    position: static;
    transform: none;
    background: none;
    box-shadow: none;
  }
  .mobile-nav-flyout .submenu a {
    font-size: 18px;
    color: currentColor;
  }
  .mobile-nav-flyout .utility-links {
    margin-top: 1rem;
    display: flex;
    gap: 20px;
  }
  .mobile-nav-flyout .utility-links a {
    text-transform: uppercase;
    font-size: 16px;
    text-decoration: none;
    color: currentColor;
  }

  .announcement-container{
    background: {{ section.settings.announcement-background }};
    padding: 8px 0px;
  }
  .announcement-content{
    color: {{ section.settings.announcement-color }};
    text-align: center;
    font-size: {{ section.settings.an_text_size_pc }}px;
    {% if section.settings.announcement_text_style == 'heading' %}
    font-family: var(--font-heading-family) !important;
    font-style: var(--font-heading-style) !important;
    font-weight: var(--font-heading-weight) !important;
    {% elsif section.settings.announcement_text_style == 'body' %}
    font-family: var(--font-body-family) !important;
    font-style: var(--font-body-style) !important;
    font-weight: var(--font-body-weight) !important;
    {% endif %}
  }
  {% unless section.settings.announcement_link %}
  .announcement-link{
    pointer-events: none;
    cursor: none;
  }
  {% endunless %}
  @media screen and (max-width: 749px) {
    .announcement-content{
      font-size: {{ section.settings.an_text_size_mobile }}px !important;
    }
  }
</style>

{% if section.settings.enable_announcement %}
<a class="announcement-link" href="{{ section.settings.announcement_link }}">
  <div class="announcement-container">
    <div class="announcement-content">{{ section.settings.announcement_text }}</div>
  </div>
</a>
{% endif %}

{% assign show_hero = false %}
{% if settings.enable-header-overlay and template == 'index' %}
  {% assign show_hero = true %}
{% endif %}
{% assign is_homepage = false %}
{% if template == 'index' %}
  {% assign is_homepage = true %}
{% endif %}

<header class="site-header{% unless show_hero %} past-banner{% endunless %}" data-has-hero="{{ show_hero }}" data-is-homepage="{{ is_homepage }}">

  {% if show_hero %}
  <div class="hero-header">
    <div class="page-width">
      <div class="header-wrapper">

        <div class="header-menu">
          {% if section.settings.menu %}
            {% for link in linklists[section.settings.menu].links %}
            <div class="menu-item{% if link.links.size > 0 %} has-children{% endif %}">
              <a href="{{ link.url }}" class="menu-link">{{ link.title }}</a>
              {% if link.links.size > 0 %}
                <div class="submenu">
                  {% for childlink in link.links %}
                    <a href="{{ childlink.url }}">{{ childlink.title }}</a>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
            {% endfor %}
          {% endif %}
        </div>

        <div class="logo-wrapper">
          <a href="{{ routes.root_url }}" class="header__heading-link">
            {%- if settings.header-overlay-logo != blank -%}
              <img src="{{ settings.header-overlay-logo | img_url: 'master' }}" alt="{{ shop.name }}" loading="eager">
            {%- elsif section.settings.logo != blank -%}
              <img src="{{ section.settings.logo | img_url: 'master' }}" alt="{{ shop.name }}" loading="eager">
            {%- else -%}
              <span class="header-logo-text">{{ shop.name }}</span>
            {%- endif -%}
          </a>
        </div>

        <div class="right-nav">
          {% if shop.customer_accounts_enabled %}
            <a href="/account">Account</a>
          {% endif %}
          {% if section.settings.track_link != blank %}
            <a href="{{ section.settings.track_link }}">Track</a>
          {% endif %}
          <a href="/cart">Cart (<span id="CartCount">{{ cart.item_count }}</span>)</a>
        </div>

      </div>
    </div>
  </div>
  {% endif %}

  <div class="compact-header">
    <div class="page-width">
      <div class="compact-wrapper">

        <button class="burger-menu" aria-label="Menu" aria-expanded="false">
          <svg class="burger" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <line x1="3" y1="7" x2="21" y2="7"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="17" x2="21" y2="17"/>
          </svg>
          <svg class="cross" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <line x1="5" y1="5" x2="19" y2="19"/>
            <line x1="19" y1="5" x2="5" y2="19"/>
          </svg>
        </button>

        <a href="{{ routes.root_url }}" class="compact-logo-wrapper" aria-label="{{ shop.name }}">
          {%- if section.settings.logo != blank -%}
            <img class="logo-original" src="{{ section.settings.logo | img_url: 'master' }}" alt="{{ shop.name }}" loading="eager">
          {%- else -%}
            <span class="logo-original header-logo-text">{{ shop.name }}</span>
          {%- endif -%}
          {%- if section.settings.logo-scrolled != blank -%}
            <img class="logo-alt" src="{{ section.settings.logo-scrolled | img_url: 'master' }}" alt="{{ shop.name }}" loading="eager">
          {%- endif -%}
        </a>

        <a class="cart-icon-link" href="/cart" aria-label="Cart">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M6 6h15l-1.5 9h-12L6 6zM6 6L5 3H2"/>
            <circle cx="9.5" cy="20" r="1.5" fill="currentColor" stroke="none"/>
            <circle cx="17.5" cy="20" r="1.5" fill="currentColor" stroke="none"/>
          </svg>
          {% if cart.item_count > 0 %}
            <span class="cart-count-bubble"><span>{{ cart.item_count }}</span></span>
          {% endif %}
        </a>

      </div>
    </div>
  </div>

  <div class="mobile-nav-flyout">
    {% if section.settings.menu %}
      {% for link in linklists[section.settings.menu].links %}
      <div class="menu-item{% if link.links.size > 0 %} has-children{% endif %}">
        <a href="{{ link.url }}" class="menu-link">{{ link.title }}</a>
        {% if link.links.size > 0 %}
          <div class="submenu">
            {% for childlink in link.links %}
              <a href="{{ childlink.url }}">{{ childlink.title }}</a>
              {% if childlink.links.size > 0 %}
                {% for subchildlink in childlink.links %}
                  <span>
                    <a class="subsub-menu-item" href="{{ subchildlink.url }}">{{ subchildlink.title }}</a>
                  </span>
                {% endfor %}
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
      {% endfor %}
    {% endif %}
    <div class="utility-links">
      {% if shop.customer_accounts_enabled %}
        <a href="/account">Account</a>
      {% endif %}
      {% if section.settings.track_link != blank %}
        <a href="{{ section.settings.track_link }}">Track</a>
      {% endif %}
    </div>
  </div>

</header>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var header = document.querySelector('.site-header');
  var banner = document.querySelector('.image-banner-container');
  var compactHeader = document.querySelector('.compact-header');
  var isHomepage = header.dataset.isHomepage === 'true';
  var lastScrollY = window.scrollY;
  var revealOffset = 80;
  var hideDelay = 350;
  var hideTimer = null;

  function scheduleHide() {
    if (hideTimer || header.classList.contains('header-hidden')) return;
    hideTimer = setTimeout(function () {
      header.classList.add('header-hidden');
      hideTimer = null;
    }, hideDelay);
  }

  function cancelHide() {
    if (hideTimer) {
      clearTimeout(hideTimer);
      hideTimer = null;
    }
    header.classList.remove('header-hidden');
  }

  function updateBodyOffset() {
    if (isHomepage) {
      document.body.style.paddingTop = '';
      return;
    }
    document.body.style.paddingTop = compactHeader.offsetHeight + 'px';
  }

  updateBodyOffset();
  window.addEventListener('resize', updateBodyOffset);
  window.addEventListener('load', updateBodyOffset);

  function updatePastBanner() {
    if (!banner) {
      header.classList.add('past-banner');
      return;
    }
    var bannerBottom = banner.getBoundingClientRect().bottom + window.scrollY;
    if (window.scrollY >= bannerBottom - 1) {
      header.classList.add('past-banner');
    } else {
      header.classList.remove('past-banner');
      header.classList.remove('header-hidden');
    }
  }

  function updateHideReveal() {
    if (!header.classList.contains('past-banner')) {
      cancelHide();
      lastScrollY = window.scrollY;
      return;
    }
    var currentY = window.scrollY;
    if (currentY <= revealOffset) {
      cancelHide();
    } else if (currentY > lastScrollY) {
      scheduleHide();
    } else if (currentY < lastScrollY) {
      cancelHide();
    }
    lastScrollY = currentY;
  }

  function onScroll() {
    updatePastBanner();
    updateHideReveal();
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  var burgerMenu = document.querySelector('.burger-menu');
  var mobileNav = document.querySelector('.mobile-nav-flyout');
  var body = document.querySelector('body');

  burgerMenu.addEventListener('click', function () {
    var isOpen = mobileNav.classList.contains('active');
    mobileNav.classList.toggle('active');
    burgerMenu.classList.toggle('active');
    burgerMenu.setAttribute('aria-expanded', String(!isOpen));
    body.style.overflow = isOpen ? 'inherit' : 'hidden';
  });

  var menuItems = document.querySelectorAll('.mobile-nav-flyout > .menu-item');
  menuItems.forEach(function (item) {
    var link = item.querySelector('.menu-link');
    link.addEventListener('click', function (event) {
      if (item.classList.contains('has-children')) {
        event.preventDefault();
        var active = document.querySelector('.mobile-nav-flyout .menu-item.active');
        if (active && active !== item) {
          active.classList.remove('active');
          active.querySelector('.submenu').style.display = 'none';
        }
        var submenu = item.querySelector('.submenu');
        submenu.style.display = submenu.style.display === 'block' ? 'none' : 'block';
        item.classList.toggle('active');
      }
    });
  });

  var heroMenuItems = document.querySelectorAll('.hero-header .header-menu > .menu-item.has-children');
  heroMenuItems.forEach(function (item) {
    var link = item.querySelector('.menu-link');
    link.addEventListener('click', function (event) {
      event.preventDefault();
      var active = document.querySelector('.hero-header .menu-item.active');
      if (active && active !== item) {
        active.classList.remove('active');
        active.querySelector('.submenu').style.display = 'none';
      }
      var submenu = item.querySelector('.submenu');
      submenu.style.display = submenu.style.display === 'block' ? 'none' : 'block';
      item.classList.toggle('active');
    });
  });

  document.addEventListener('click', function (event) {
    if (!event.target.closest('.menu-item')) {
      document.querySelectorAll('.hero-header .submenu').forEach(function (submenu) {
        submenu.style.display = 'none';
      });
      document.querySelectorAll('.hero-header .menu-item.active').forEach(function (item) {
        item.classList.remove('active');
      });
    }
  });
});
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "header",
      "content": "Hero header (homepage banner)",
      "info": "Shown at the top of the homepage while it overlays the image banner. Requires Theme Settings => Header overlay to be enabled. Hidden on mobile."
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo-size",
      "min": 50,
      "max": 400,
      "step": 5,
      "default": 150,
      "unit": "px",
      "label": "Logo size (desktop)"
    },
    {
      "type": "range",
      "id": "nav-text-size",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 16,
      "unit": "px",
      "label": "Link text size",
      "info": "Applies uniformly to all links on both sides of the logo"
    },
    {
      "type": "range",
      "id": "link-spacing",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 24,
      "unit": "px",
      "label": "Space between links"
    },
    {
      "type": "header",
      "content": "Navigation links"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Header menu",
      "info": "e.g. Shop, About, Roots. Shown inline in the hero header, and inside the hamburger menu everywhere else."
    },
    {
      "type": "url",
      "id": "track_link",
      "label": "Track order link",
      "info": "Shown after Account in the hero header and inside the hamburger menu. Leave blank to hide."
    },
    {
      "type": "header",
      "content": "Compact header (scrolled / all other pages)",
      "info": "Hamburger, centered logo, and cart icon. Used on mobile at all times, and on desktop once you scroll past the homepage banner or on any page without a banner."
    },
    {
      "type": "image_picker",
      "id": "logo-scrolled",
      "label": "Logo (scrolled / compact state)",
      "info": "Optional. Falls back to the main logo above if left blank."
    },
    {
      "type": "range",
      "id": "logo-size-compact",
      "min": 20,
      "max": 200,
      "step": 5,
      "default": 50,
      "unit": "px",
      "label": "Logo size (desktop)"
    },
    {
      "type": "range",
      "id": "logo-size-compact-mobile",
      "min": 20,
      "max": 160,
      "step": 5,
      "default": 40,
      "unit": "px",
      "label": "Logo size (mobile)"
    },
    {
      "type": "color",
      "id": "compact-color",
      "label": "Icon & text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "compact-bg",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "compact-icon-size",
      "min": 14,
      "max": 40,
      "step": 1,
      "default": 24,
      "unit": "px",
      "label": "Icon size (desktop)"
    },
    {
      "type": "range",
      "id": "compact-icon-size-mobile",
      "min": 14,
      "max": 34,
      "step": 1,
      "default": 22,
      "unit": "px",
      "label": "Icon size (mobile)"
    },
    {
      "type": "range",
      "id": "compact-padding-x",
      "min": 10,
      "max": 100,
      "step": 2,
      "default": 40,
      "unit": "px",
      "label": "Icon padding from page edge (desktop)"
    },
    {
      "type": "range",
      "id": "compact-padding-x-mobile",
      "min": 10,
      "max": 60,
      "step": 2,
      "default": 20,
      "unit": "px",
      "label": "Icon padding from page edge (mobile)"
    },
    {
      "type": "range",
      "id": "compact-padding-y",
      "min": 8,
      "max": 60,
      "step": 2,
      "default": 20,
      "unit": "px",
      "label": "Vertical padding / header height (desktop)"
    },
    {
      "type": "range",
      "id": "compact-padding-y-mobile",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 14,
      "unit": "px",
      "label": "Vertical padding / header height (mobile)"
    },
    {
      "type": "header",
      "content": "Announcement"
    },
    {
      "type": "checkbox",
      "id": "enable_announcement",
      "label": "Enable announcement",
      "default": false
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement",
      "default": "Announce something here"
    },
    {
      "type": "color",
      "id": "announcement-background",
      "label": "Announcement background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "announcement-color",
      "label": "Announcement text color",
      "default": "#FFFFFF"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Link (optional)"
    },
    {
      "type": "select",
      "id": "announcement_text_style",
